{
  "consumer": {
    "name": "insight-frontend"
  },
  "interactions": [
    {
      "description": "queue email for dispatch",
      "providerStates": [
        {
          "name": "email log directory is writable"
        }
      ],
      "request": {
        "body": {
          "body": "Please enqueue",
          "from_name": "Frontend",
          "subject": "Contract test",
          "to": "team@example.com"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/utils/send-email"
      },
      "response": {
        "body": {
          "logged": true,
          "status": "queued"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.0.0"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "insight-backend"
  }
}
